PORT=8080
PUBLIC_ORIGIN=https://applypilot-jobs.netlify.app
DATABASE_PATH=./data/applypilot.sqlite
UPLOAD_DIR=./data/resumes
# Optional AI fallback. Never put the key in the Netlify frontend.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional public job-page drafting with Gemini URL Context. The key stays on
# the backend. Only the exact sanitized public job URL and employer question
# are sent to Google.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Required: private family invitation code (24+ random characters)
REGISTRATION_CODE=
# Required: signs 12-hour sessions (32+ random characters)
SESSION_SECRET=

# Public Railway URL, permits same-origin requests from /assistant
SERVICE_ORIGIN=https://your-service.up.railway.app
# Comma or newline separated employer boards (max 12); verify employers fit your profiles.
DISCOVERY_BOARDS=https://jobs.lever.co/newton
SEARCH_INTERVAL_HOURS=6
CHAT_DAILY_LIMIT=30
SAME_COMPANY_APPLICATION_LIMIT=5
SAME_COMPANY_WINDOW_DAYS=60

# Optional blocker emails; keep the key only in backend hosting variables.
RESEND_API_KEY=
BLOCKER_EMAIL_FROM=
