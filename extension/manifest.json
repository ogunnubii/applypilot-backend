{
  "manifest_version": 3,
  "name": "ApplyPilot Local",
  "version": "0.6.13",
  "description": "Autofill supported application fields from your saved facts. You control navigation and every Submit click.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://applypilot-jobs.netlify.app/*",
    "http://localhost:8080/*",
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.workdayjobs.com/*",
    "https://*.ashbyhq.com/*",
    "https://*.smartrecruiters.com/*",
    "https://*.workable.com/*",
    "https://*.bamboohr.com/*",
    "https://*.recruitee.com/*",
    "https://applypilot-jobs.pages.dev/*",
    "https://marvelous-vitality-production-c2d8.up.railway.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ApplyPilot Local"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.workdayjobs.com/*",
        "https://*.ashbyhq.com/*",
        "https://*.smartrecruiters.com/*",
        "https://*.workable.com/*",
        "https://*.bamboohr.com/*",
        "https://*.recruitee.com/*"
      ],
      "js": [
        "policy.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://applypilot-jobs.pages.dev/*",
        "https://applypilot-jobs.netlify.app/*",
        "http://localhost:8080/*",
        "https://marvelous-vitality-production-c2d8.up.railway.app/*"
      ],
      "js": [
        "dashboard-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
