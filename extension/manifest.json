{
  "manifest_version": 3,
  "name": "ApplyPilot Local",
  "version": "0.7.3",
  "description": "Prepare supported application fields, including LinkedIn Easy Apply and Indeed Apply, from your saved facts.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://applypilot-jobs.netlify.app/*",
    "http://localhost/*",
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.workdayjobs.com/*",
    "https://*.ashbyhq.com/*",
    "https://*.smartrecruiters.com/*",
    "https://*.workable.com/*",
    "https://*.bamboohr.com/*",
    "https://*.recruitee.com/*",
    "https://applypilot-jobs.pages.dev/*",
    "https://marvelous-vitality-production-c2d8.up.railway.app/*",
    "https://careers.trivago.com/*",
    "https://*.iitjobs.com/job/*",
    "https://*.randstad.ca/jobs/*",
    "https://join.jfrog.com/job/*",
    "https://careers-kinaxis.icims.com/jobs/*",
    "https://careers.deloitte.ca/job/*",
    "https://*.indeed.com/*",
    "https://www.linkedin.com/jobs/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ApplyPilot Local"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.workdayjobs.com/*",
        "https://*.ashbyhq.com/*",
        "https://*.smartrecruiters.com/*",
        "https://*.workable.com/*",
        "https://*.bamboohr.com/*",
        "https://*.recruitee.com/*",
        "https://*.iitjobs.com/job/*",
        "https://*.randstad.ca/jobs/*",
        "https://join.jfrog.com/job/*",
        "https://careers-kinaxis.icims.com/jobs/*",
        "https://careers.deloitte.ca/job/*",
        "https://www.linkedin.com/jobs/view/*",
        "https://*.indeed.com/viewjob*",
        "https://*.indeed.com/m/viewjob*",
        "https://smartapply.indeed.com/beta/indeedapply/*"
      ],
      "js": [
        "policy.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://applypilot-jobs.pages.dev/*",
        "https://applypilot-jobs.netlify.app/*",
        "http://localhost/assistant*",
        "https://marvelous-vitality-production-c2d8.up.railway.app/*"
      ],
      "js": [
        "dashboard-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.linkedin.com/jobs/search*",
        "https://www.linkedin.com/jobs/collections*",
        "https://*.indeed.com/jobs*",
        "https://*.indeed.com/q-*",
        "https://*.indeed.com/m/jobs*"
      ],
      "js": [
        "policy.js",
        "board-import.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
